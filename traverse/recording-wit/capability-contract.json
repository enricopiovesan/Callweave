{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "audio.recording-session",
  "version": "0.1.0",
  "lifecycle": "draft",
  "summary": "Start and observe a bounded foreground recording through Traverse's portable local recording-host WIT import.",
  "description": "The capability requests a recording session through traverse:platform/recording-host@0.1.0. It never imports target APIs, receives audio bytes, chooses storage, exposes a path, or implements permissions or background execution.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": ["request_id", "source_profile_ref", "duration_seconds", "idempotency_key"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_profile_ref": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "idempotency_key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": ["result_class", "artifact_ref"],
      "properties": {
        "result_class": { "type": "string", "enum": ["started", "stopped", "permission_required", "unavailable", "background_unsupported", "recording_busy"] },
        "artifact_ref": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "host_import": {
    "wit_package": "traverse:platform@0.1.0",
    "interface": "recording-host",
    "world": "recording-capability"
  },
  "side_effects": [{ "kind": "external_effect", "description": "Requests a bounded recording from the local host." }],
  "permissions": [{ "id": "audio.recording-session.execute" }],
  "permitted_targets": ["local", "device"],
  "execution": {
    "execution_profile": "component-wit-v1",
    "required_wit_imports": [{
      "package": "traverse:platform",
      "interface": "recording-host",
      "version": "0.1.0"
    }],
    "wit_bindings": {
      "traverse:platform/recording-host@0.1.0": "callweave-local-recording"
    }
  },
  "execution_status": "awaiting_target_host_adapter"
}
