{
  "schema_version": "0.1.0",
  "lifecycle": "draft",
  "id": "callweave.local-first-host-adapters",
  "rule": "Capabilities receive explicit requests and typed references only; hosts hold credentials, device handles, filesystem access, and transaction authority.",
  "adapters": [
    {
      "id": "scheduler",
      "authority": "invoke daily-close after local-day grace period",
      "inputs": [
        "location_id",
        "local_date",
        "timezone",
        "grace_period"
      ],
      "outputs": [
        "invocation_id",
        "idempotency_key"
      ],
      "failure_modes": [
        "clock_unavailable",
        "duplicate_invocation",
        "late_invocation"
      ]
    },
    {
      "id": "clock-timezone",
      "authority": "resolve IANA timezone and bounded local day",
      "inputs": [
        "location_id",
        "instant"
      ],
      "outputs": [
        "local_date",
        "timezone",
        "day_start",
        "day_end"
      ],
      "failure_modes": [
        "timezone_unresolved",
        "clock_skew"
      ]
    },
    {
      "id": "occurrence-source-provider",
      "authority": "import permitted occurrence facts from approved source providers under bounded network authority",
      "inputs": [
        "location_input",
        "candidate_source_policy"
      ],
      "outputs": [
        "source_fact_set_ref",
        "license_manifest_ref"
      ],
      "failure_modes": [
        "network_unavailable",
        "provider_unavailable",
        "license_policy_denied"
      ]
    },
    {
      "id": "audio-device",
      "authority": "capture configured microphone samples",
      "inputs": [
        "audio_source_ref",
        "capture_window"
      ],
      "outputs": [
        "recording_ref"
      ],
      "failure_modes": [
        "device_unavailable",
        "format_unsupported",
        "power_interrupted"
      ]
    },
    {
      "id": "local-object-store",
      "authority": "atomically store immutable audio and derived assets",
      "inputs": [
        "asset_stream",
        "retention_class"
      ],
      "outputs": [
        "asset_ref",
        "checksum"
      ],
      "failure_modes": [
        "storage_full",
        "checksum_mismatch",
        "write_interrupted"
      ]
    },
    {
      "id": "private-location-store",
      "authority": "persist private location profiles and seasonal candidate sets under append-only local ownership",
      "inputs": [
        "location_profile_payload",
        "idempotency_key"
      ],
      "outputs": [
        "location_profile_ref",
        "trace_ref"
      ],
      "failure_modes": [
        "storage_full",
        "write_interrupted",
        "idempotency_conflict"
      ]
    },
    {
      "id": "operations-export",
      "authority": "export privacy-filtered governed state and reports to approved local or remote destinations under bounded network authority",
      "inputs": [
        "operations_request",
        "operations_policy"
      ],
      "outputs": [
        "export_bundle_ref",
        "export_trace_ref"
      ],
      "failure_modes": [
        "network_unavailable",
        "destination_unavailable",
        "export_policy_denied"
      ]
    },
    {
      "id": "backup-destination",
      "authority": "verify and write encrypted backup material to an approved destination under bounded network authority",
      "inputs": [
        "backup_payload_ref",
        "operations_policy"
      ],
      "outputs": [
        "backup_receipt_ref",
        "backup_trace_ref"
      ],
      "failure_modes": [
        "network_unavailable",
        "destination_unavailable",
        "verification_failed"
      ]
    },
    {
      "id": "local-model-trainer",
      "authority": "build approved local training sets and train a local adapter under bounded local compute authority",
      "inputs": [
        "training_request",
        "model_release_policy"
      ],
      "outputs": [
        "trained_candidate_ref",
        "training_trace_ref"
      ],
      "failure_modes": [
        "insufficient_verified_data",
        "hardware_incompatible",
        "training_failed"
      ]
    },
    {
      "id": "local-model-evaluator",
      "authority": "evaluate a trained candidate against approved held-out data under bounded local compute authority",
      "inputs": [
        "trained_candidate_ref",
        "model_release_policy"
      ],
      "outputs": [
        "evaluation_ref",
        "evaluation_trace_ref"
      ],
      "failure_modes": [
        "held_out_data_unavailable",
        "hardware_incompatible",
        "evaluation_failed"
      ]
    },
    {
      "id": "local-model-release-store",
      "authority": "publish or roll back verified local model releases under append-only local ownership",
      "inputs": [
        "release_decision",
        "idempotency_key"
      ],
      "outputs": [
        "model_release_ref",
        "release_trace_ref"
      ],
      "failure_modes": [
        "storage_full",
        "write_interrupted",
        "idempotency_conflict"
      ]
    },
    {
      "id": "review-package-builder",
      "authority": "assemble sanitized advisory review bundles and strict prompts from protected local assets under bounded local authority",
      "inputs": [
        "unknown_cluster_ref",
        "review_policy"
      ],
      "outputs": [
        "review_bundle_ref",
        "prompt_ref"
      ],
      "failure_modes": [
        "reference_unresolvable",
        "privacy_not_protected",
        "bundle_build_failed"
      ]
    },
    {
      "id": "advisory-response-ingest",
      "authority": "ingest a bounded external advisory response supplied by the host and expose only typed response content",
      "inputs": [
        "review_bundle_ref",
        "response_payload"
      ],
      "outputs": [
        "advisory_response_ref",
        "response_trace_ref"
      ],
      "failure_modes": [
        "response_missing",
        "response_schema_invalid",
        "response_provenance_missing"
      ]
    },
    {
      "id": "review-proposal-store",
      "authority": "persist validated review proposals under append-only local ownership",
      "inputs": [
        "review_proposal",
        "idempotency_key"
      ],
      "outputs": [
        "review_proposal_ref",
        "proposal_trace_ref"
      ],
      "failure_modes": [
        "storage_full",
        "write_interrupted",
        "idempotency_conflict"
      ]
    },
    {
      "id": "local-state-store",
      "authority": "resolve typed records and atomically append idempotent transitions",
      "inputs": [
        "record_refs",
        "idempotency_key",
        "transition"
      ],
      "outputs": [
        "result_ref",
        "trace_ref"
      ],
      "failure_modes": [
        "reference_unresolvable",
        "version_conflict",
        "idempotency_conflict"
      ]
    },
    {
      "id": "local-model-runtime",
      "authority": "load verified local models and return evidence only",
      "inputs": [
        "model_manifest_ref",
        "prepared_audio_ref"
      ],
      "outputs": [
        "acoustic_evidence_ref"
      ],
      "failure_modes": [
        "model_unavailable",
        "checksum_mismatch",
        "hardware_incompatible"
      ]
    }
  ]
}
