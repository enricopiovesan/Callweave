          "metadata": {}
        },
        "capture_window": {
          "id": "capture_window-001",
          "version": "1.0.0",
          "metadata": {}
        }
      },
      "output_example": {
        "status": "deferred",
        "reason_code": "dependency_unavailable",
        "recording_ref": null,
        "trace_ref": "audio-capture-trace-003",
        "warnings": [
          "dependency_unavailable"
        ]
      },
      "happy": false,
      "persona_ref": "callweave-system-administrator"
    },
    {
      "scenario": "As a Reviewer, I want policy-prohibited work denied without side effects so that privacy, hardware, and approval boundaries remain authoritative.",
      "input_example": {
        "request_id": "audio-capture-failure-003",
