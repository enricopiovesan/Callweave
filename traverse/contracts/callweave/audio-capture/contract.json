      "output_example": {
        "status": "rejected",
        "reason_code": "policy_denied",
        "recording_ref": null,
        "trace_ref": "audio-capture-trace-004",
        "warnings": [
          "policy_denied"
        ]
      },
      "happy": false,
      "persona_ref": "callweave-reviewer"
    }
  ],
