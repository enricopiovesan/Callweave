  "summary": "Capture, finalize, validate, and retain lossless audio recordings.",
  "description": "Captures audio from a configured source, rotates 15-minute master files, finalizes them atomically, validates integrity, and applies retention policy. Audio capture and file writes are host adapters; the governed result is a durable recording reference with checksum and coverage state.\n\nImplementation status: contract-first. A WASM component/agent will be generated after contract approval. The host provides only the declared adapter authority.\n\nUse-case coverage: one happy path plus invalid-input, dependency-unavailable, and policy-denied unhappy paths.",
  "use_cases": [
    {
      "scenario": "As a Field Operator, I want capture, finalize, validate, and retain lossless audio recordings. so that the governed workflow can continue with traceable evidence.",
      "input_example": {
        "request_id": "audio-capture-happy-001",
        "workspace_id": "local-default",
        "location_id": "golden-bc-demo",
        "idempotency_key": "audio-capture-idempotency-001",
        "audio_source_ref": {
          "id": "audio_source_ref-001",
          "version": "1.0.0",
          "metadata": {}
        },
        "capture_window": {
          "id": "capture_window-001",
          "version": "1.0.0",
          "metadata": {}
        }
      },
      "output_example": {
        "status": "completed",
        "reason_code": "ok",
        "recording_ref": "audio-capture-result-001",
        "trace_ref": "audio-capture-trace-001",
        "warnings": []
      },
      "happy": true,
      "persona_ref": "callweave-field-operator"
    },
    {
      "scenario": "As the Callweave Runtime, I want malformed or incomplete input rejected so that this capability fails closed before creating state.",
      "input_example": {
        "request_id": "audio-capture-failure-001",
        "workspace_id": "local-default",
        "location_id": "golden-bc-demo",
        "idempotency_key": "audio-capture-idempotency-failure-001",
        "audio_source_ref": {
          "id": "audio_source_ref-001",
          "version": "1.0.0",
          "metadata": {}
        },
        "capture_window": {
          "id": "capture_window-001",
          "version": "1.0.0",
          "metadata": {}
        }
      },
      "output_example": {
        "status": "rejected",
        "reason_code": "invalid_input",
        "recording_ref": null,
        "trace_ref": "audio-capture-trace-002",
        "warnings": [
          "invalid_input"
        ]
      },
      "happy": false,
      "persona_ref": "callweave-system-administrator"
    },
    {
      "scenario": "As a System Administrator, I want unavailable required host/model dependencies reported explicitly so that the workflow can defer or use an approved fallback.",
