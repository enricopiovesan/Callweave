{
  "kind": "capability_contract", "schema_version": "1.0.0", "id": "artifact.recording-finalize", "namespace": "artifact", "name": "recording-finalize", "version": "1.0.1", "lifecycle": "active",
  "owner": { "team": "callweave", "contact": "https://github.com/enricopiovesan" },
  "licensing": { "spdx_expression": "MIT OR Apache-2.0", "commercial_use": "allowed", "redistribution": "allowed", "attribution_required": true, "verification": { "status": "maintainer-declared" }, "license_files": ["LICENSE-MIT", "LICENSE-APACHE"], "source_url": "https://github.com/enricopiovesan/Callweave" },
  "summary": "Finalize captured recording bytes as an immutable artifact through a declared object-store connector.",
  "description": "A portable WASM capability that submits an opaque captured-content reference for immutable storage. It never receives recording bytes, chooses a filesystem/database/provider, accesses a microphone, knows an application, or exposes host-private storage details.",
  "use_cases": [
    { "scenario": "As an artifact operator, I want captured audio finalized once as an immutable asset so that later processing refers to verified content.", "input_example": { "content_ref": "capture-buffer:segment-17", "media_type": "audio/wav", "retention_class": "standard", "idempotency_key": "finalize-segment-17" }, "output_example": { "asset_ref": "asset:sha256:segment-17", "content_digest": "sha256:segment-17", "size": 128, "result_class": "created" }, "happy": true, "persona_ref": "artifact-operator" },
    { "scenario": "As an artifact operator, I want an idempotent replay reported so that a retry does not duplicate a recording artifact.", "input_example": { "content_ref": "capture-buffer:segment-17", "media_type": "audio/wav", "retention_class": "standard", "idempotency_key": "finalize-segment-17" }, "output_example": { "asset_ref": "asset:sha256:segment-17", "content_digest": "sha256:segment-17", "size": 128, "result_class": "replayed" }, "happy": true, "persona_ref": "artifact-operator" },
    { "scenario": "As an artifact operator, I want unavailable storage represented without a path, credential, or provider detail so that host internals stay private.", "input_example": { "content_ref": "capture-buffer:segment-17", "media_type": "audio/wav", "retention_class": "standard", "idempotency_key": "finalize-unavailable" }, "output_example": { "asset_ref": "", "content_digest": "", "size": 0, "result_class": "connector_unavailable" }, "happy": false, "persona_ref": "artifact-operator" }
  ],
  "inputs": { "schema": { "type": "object", "required": ["content_ref", "media_type", "retention_class", "idempotency_key"], "properties": { "content_ref": { "type": "string", "minLength": 1 }, "media_type": { "type": "string", "minLength": 1 }, "retention_class": { "type": "string", "minLength": 1 }, "idempotency_key": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
  "outputs": { "schema": { "type": "object", "required": ["asset_ref", "content_digest", "size", "result_class"], "properties": { "asset_ref": { "type": "string" }, "content_digest": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "result_class": { "type": "string", "enum": ["created", "replayed", "connector_unavailable", "invalid_request"] } }, "additionalProperties": false } },
  "preconditions": [ { "id": "opaque-content-reference", "description": "A non-empty opaque content reference is supplied." }, { "id": "object-store-activated", "description": "The host has activated a compatible Traverse object-store binding." } ],
  "postconditions": [ { "id": "immutable-or-stable-result", "description": "The result represents one immutable write, a replay, or a stable non-secret inability to submit." }, { "id": "no-host-detail-leakage", "description": "No path, provider, credential, or private configuration is returned." } ],
  "side_effects": [ { "kind": "state_change", "description": "Requests an immutable object finalization through the declared object-store connector." } ], "emits": [], "consumes": [], "permissions": [ { "id": "artifact.recording-finalize.execute" } ],
  "execution": { "binary_format": "wasm", "entrypoint": { "kind": "wasi-command", "command": "run" }, "preferred_targets": ["local", "browser", "edge", "device"], "constraints": { "host_api_access": "exception_required", "network_access": "forbidden", "filesystem_access": "none" } },
  "policies": [ { "id": "immutable-artifact-policy" }, { "id": "host-details-forbidden" } ], "dependencies": [], "connector_requirements": [ { "connector_id": "traverse.object-store", "version": "^1.0.0" } ],
  "provenance": { "source": "greenfield", "author": "Callweave", "created_at": "2026-09-05T00:00:00Z", "spec_ref": "104-mediated-connector-invocation@1.0.0", "adr_refs": ["ADR-0039"], "exception_refs": ["mediated-connector-invoke"] }, "evidence": [], "state_schema": null, "service_type": "stateless", "permitted_targets": ["local", "browser", "edge", "device"]
}
