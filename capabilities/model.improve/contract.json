{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "model.improve",
  "namespace": "model",
  "name": "improve",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Evaluate a verified model candidate against deterministic release thresholds.",
  "description": "Pure standalone model release policy. It rejects unverified artifacts, rejects evaluations below threshold, and approves a release only when the supplied verified artifact and held-out evaluation facts pass the governed gate. It does not train, download, cache, activate, or persist models.",
  "use_cases": [
    {
      "scenario": "As a system administrator, I want a verified candidate that passes held-out precision and recall thresholds approved so that a local release can be activated separately.",
      "input_example": {
        "candidate": {
          "id": "birdnet-adapter-2",
          "sha256": "abc123",
          "license": "MIT",
          "status": "verified"
        },
        "evaluation": {
          "held_out_precision_millis": 910,
          "held_out_recall_millis": 890
        },
        "policy": {
          "version": "release-gate-1",
          "minimum_precision_millis": 900,
          "minimum_recall_millis": 850
        },
        "activeModelId": "birdnet-adapter-1"
      },
      "output_example": {
        "decision": "approve",
        "reason": "release_gate_passed",
        "active_model_id": "birdnet-adapter-2",
        "previous_model_id": "birdnet-adapter-1",
        "release_id": "release-birdnet-adapter-2"
      },
      "happy": true
    },
    {
      "scenario": "As a system administrator, I want an unverified artifact rejected before evaluation thresholds matter so that unchecked model files cannot be promoted.",
      "input_example": {
        "candidate": {
          "id": "birdnet-adapter-2",
          "sha256": "abc123",
          "license": "MIT",
          "status": "pending"
        },
        "evaluation": {
          "held_out_precision_millis": 950,
          "held_out_recall_millis": 930
        },
        "policy": {
          "version": "release-gate-1",
          "minimum_precision_millis": 900,
          "minimum_recall_millis": 850
        },
        "activeModelId": "birdnet-adapter-1"
      },
      "output_example": {
        "decision": "reject",
        "reason": "artifact_not_verified",
        "active_model_id": "birdnet-adapter-1"
      },
      "happy": false
    },
    {
      "scenario": "As a system administrator, I want a verified candidate below recall threshold rejected so that weak evaluations do not silently replace a known-good model.",
      "input_example": {
        "candidate": {
          "id": "birdnet-adapter-3",
          "sha256": "def456",
          "license": "MIT",
          "status": "verified"
        },
        "evaluation": {
          "held_out_precision_millis": 930,
          "held_out_recall_millis": 700
        },
        "policy": {
          "version": "release-gate-1",
          "minimum_precision_millis": 900,
          "minimum_recall_millis": 850
        },
        "activeModelId": "birdnet-adapter-1"
      },
      "output_example": {
        "decision": "reject",
        "reason": "evaluation_below_threshold",
        "active_model_id": "birdnet-adapter-1"
      },
      "happy": false
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": ["candidate", "policy"],
      "properties": {
        "candidate": {
          "type": "object",
          "required": ["id", "sha256", "license", "status"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "enum": ["verified", "pending", "rejected"] }
          },
          "additionalProperties": true
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "held_out_precision_millis": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "held_out_recall_millis": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "additionalProperties": true
        },
        "policy": {
          "type": "object",
          "required": ["version", "minimum_precision_millis", "minimum_recall_millis"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "minimum_precision_millis": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "minimum_recall_millis": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "activeModelId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": ["decision", "reason", "active_model_id"],
      "properties": {
        "decision": { "type": "string", "enum": ["approve", "reject"] },
        "reason": { "type": "string", "enum": ["release_gate_passed", "artifact_not_verified", "evaluation_below_threshold"] },
        "active_model_id": { "type": ["string", "null"] },
        "previous_model_id": { "type": "string" },
        "release_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "preconditions": [
    {
      "id": "verified-artifact-and-policy-supplied",
      "description": "A candidate id, checksum, license, status, and release policy are supplied."
    }
  ],
  "postconditions": [
    {
      "id": "unverified-artifacts-cannot-pass",
      "description": "Only a verified artifact may return decision approve."
    },
    {
      "id": "threshold-failure-keeps-active-model",
      "description": "Rejected results preserve the currently active model id."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure calculation; no host, network, filesystem, model provider, cache, or workflow access."
    }
  ],
  "emits": [],
  "consumes": [],
  "permissions": [
    {
      "id": "model.improve.execute"
    }
  ],
  "execution": {
    "binary_format": "wasm",
    "entrypoint": {
      "kind": "wasi-command",
      "command": "run"
    },
    "preferred_targets": ["local", "browser", "edge", "device"],
    "constraints": {
      "host_api_access": "none",
      "network_access": "forbidden",
      "filesystem_access": "none"
    }
  },
  "policies": [
    { "id": "deterministic-policy-only" },
    { "id": "artifact-must-be-verified-before-release" }
  ],
  "dependencies": [],
  "provenance": {
    "source": "greenfield",
    "author": "Callweave",
    "created_at": "2026-08-20T00:00:00Z",
    "spec_ref": "100-capability-package-authoring@1.0.0",
    "adr_refs": ["DECISION_RECORD.md"],
    "exception_refs": []
  },
  "evidence": [],
  "state_schema": null,
  "service_type": "stateless",
  "permitted_targets": ["local", "browser", "edge", "device"]
}
