{
  "kind": "capability_contract", "schema_version": "1.0.0", "id": "evidence.coverage-assess", "namespace": "evidence", "name": "coverage-assess", "version": "1.0.0", "lifecycle": "active",
  "owner": { "team": "callweave", "contact": "maintainers@callweave.local" },
  "summary": "Assess the completeness of supplied evidence coverage facts.",
  "description": "Pure standalone coverage calculation. It distinguishes complete, partial, and unavailable evidence from supplied minutes and source health. It does not capture audio, inspect a device, query storage, schedule work, or know any application workflow.",
  "use_cases": [
    { "scenario": "As an evidence consumer, I want fully captured and processed healthy evidence marked complete so that I can trust the coverage boundary.", "input_example": { "coverage_facts": { "expected_minutes": 1440, "captured_minutes": 1440, "valid_minutes": 1435, "processed_minutes": 1435, "source_health": "healthy" }, "coverage_policy": { "version": "1.0.0", "complete_threshold_millis": 950 } }, "output_example": { "coverage_state": "complete", "coverage_millis": 996, "reason_code": "coverage_complete", "policy_version": "1.0.0" }, "happy": true },
    { "scenario": "As an evidence consumer, I want an incomplete but healthy day marked partial rather than confused with silence.", "input_example": { "coverage_facts": { "expected_minutes": 1440, "captured_minutes": 900, "valid_minutes": 850, "processed_minutes": 850, "source_health": "healthy" }, "coverage_policy": { "version": "1.0.0", "complete_threshold_millis": 950 } }, "output_example": { "coverage_state": "partial", "coverage_millis": 590, "reason_code": "coverage_partial", "policy_version": "1.0.0" }, "happy": true },
    { "scenario": "As an evidence consumer, I want an unhealthy source marked unavailable so that equipment failure is not interpreted as ecological absence.", "input_example": { "coverage_facts": { "expected_minutes": 1440, "captured_minutes": 0, "valid_minutes": 0, "processed_minutes": 0, "source_health": "unhealthy" }, "coverage_policy": { "version": "1.0.0", "complete_threshold_millis": 950 } }, "output_example": { "coverage_state": "unavailable", "coverage_millis": 0, "reason_code": "source_unhealthy", "policy_version": "1.0.0" }, "happy": false },
    { "scenario": "As an evidence consumer, I want an invalid expected duration marked unavailable so that coverage is never invented.", "input_example": { "coverage_facts": { "expected_minutes": 0, "captured_minutes": 0, "valid_minutes": 0, "processed_minutes": 0, "source_health": "healthy" }, "coverage_policy": { "version": "1.0.0", "complete_threshold_millis": 950 } }, "output_example": { "coverage_state": "unavailable", "coverage_millis": 0, "reason_code": "invalid_scope", "policy_version": "1.0.0" }, "happy": false }
  ],
  "inputs": { "schema": { "type": "object", "required": ["coverage_facts", "coverage_policy"], "properties": { "coverage_facts": { "type": "object", "required": ["expected_minutes", "captured_minutes", "valid_minutes", "processed_minutes", "source_health"], "properties": { "expected_minutes": { "type": "integer", "minimum": 0 }, "captured_minutes": { "type": "integer", "minimum": 0 }, "valid_minutes": { "type": "integer", "minimum": 0 }, "processed_minutes": { "type": "integer", "minimum": 0 }, "source_health": { "type": "string", "enum": ["healthy", "unhealthy"] } }, "additionalProperties": false }, "coverage_policy": { "type": "object", "required": ["version", "complete_threshold_millis"], "properties": { "version": { "type": "string", "minLength": 1 }, "complete_threshold_millis": { "type": "integer", "minimum": 0, "maximum": 1000 } }, "additionalProperties": false } }, "additionalProperties": false } },
  "outputs": { "schema": { "type": "object", "required": ["coverage_state", "coverage_millis", "reason_code", "policy_version"], "properties": { "coverage_state": { "type": "string", "enum": ["complete", "partial", "unavailable"] }, "coverage_millis": { "type": "integer", "minimum": 0, "maximum": 1000 }, "reason_code": { "type": "string", "enum": ["coverage_complete", "coverage_partial", "source_unhealthy", "invalid_scope"] }, "policy_version": { "type": "string" } }, "additionalProperties": false } },
  "preconditions": [{ "id": "policy-is-versioned", "description": "A non-empty policy version and bounded completion threshold are supplied." }],
  "postconditions": [{ "id": "deterministic", "description": "Identical facts and policy inputs yield identical output." }, { "id": "silence-not-inferred", "description": "An unavailable or partial result does not make an ecological claim." }],
  "side_effects": [{ "kind": "memory_only", "description": "Pure calculation; no host, network, filesystem, model, or state access." }],
  "emits": [], "consumes": [], "permissions": [{ "id": "evidence.coverage-assess.execute" }],
  "execution": { "binary_format": "wasm", "entrypoint": { "kind": "wasi-command", "command": "run" }, "preferred_targets": ["local", "browser", "edge", "device"], "constraints": { "host_api_access": "none", "network_access": "forbidden", "filesystem_access": "none" } },
  "policies": [{ "id": "deterministic-policy-only" }, { "id": "absence-not-inferred" }], "dependencies": [],
  "provenance": { "source": "greenfield", "author": "Callweave", "created_at": "2026-08-17T00:00:00Z", "spec_ref": "100-capability-package-authoring@1.0.0", "adr_refs": ["DECISION_RECORD.md"], "exception_refs": [] },
  "evidence": [], "state_schema": null, "service_type": "stateless", "permitted_targets": ["local", "browser", "edge", "device"]
}
