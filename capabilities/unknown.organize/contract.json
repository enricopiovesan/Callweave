{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "unknown.organize",
  "namespace": "unknown",
  "name": "organize",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Cluster uncertain evidence into stable local unknown-sound groups.",
  "description": "Pure standalone clustering policy. It groups supplied equal-length embeddings by deterministic cosine threshold, returns stable cluster identifiers and representative members, and never claims a taxon. It does not load embeddings, read storage, or mutate any workflow-owned state.",
  "use_cases": [
    {
      "scenario": "As a reviewer, I want similar unknown evidence grouped together so that I can inspect one local cluster instead of isolated clips.",
      "input_example": {
        "items": [
          { "id": "ev-1", "embedding": [1, 0, 0] },
          { "id": "ev-2", "embedding": [0.99, 0.01, 0] },
          { "id": "ev-3", "embedding": [0, 1, 0] }
        ],
        "policy": {
          "version": "cluster-1",
          "minimum_cosine": 0.95
        }
      },
      "output_example": [
        {
          "member_ids": ["ev-1", "ev-2"],
          "representative_id": "ev-1",
          "policy_version": "cluster-1"
        },
        {
          "member_ids": ["ev-3"],
          "representative_id": "ev-3",
          "policy_version": "cluster-1"
        }
      ],
      "happy": true
    },
    {
      "scenario": "As a reviewer, I want incompatible embedding sizes rejected so that malformed evidence never produces a misleading cluster.",
      "input_example": {
        "items": [
          { "id": "ev-1", "embedding": [1, 0] },
          { "id": "ev-2", "embedding": [1, 0, 0] }
        ],
        "policy": {
          "version": "cluster-1",
          "minimum_cosine": 0.95
        }
      },
      "output_example": {
        "error": "items require equal finite embeddings"
      },
      "happy": false
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": ["items", "policy"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "embedding"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "embedding": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 1
              }
            },
            "additionalProperties": true
          }
        },
        "policy": {
          "type": "object",
          "required": ["version", "minimum_cosine"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "minimum_cosine": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["member_ids", "representative_id", "policy_version"],
        "properties": {
          "member_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "representative_id": { "type": "string" },
          "policy_version": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "preconditions": [
    {
      "id": "equal-finite-embeddings",
      "description": "Every input item has a non-empty id and equal-length finite embeddings."
    }
  ],
  "postconditions": [
    {
      "id": "clustering-is-deterministic",
      "description": "The same items and cosine threshold produce the same grouping and ordering."
    },
    {
      "id": "taxonomy-is-not-inferred",
      "description": "Outputs contain only cluster structure, not a biological identification."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure calculation; no host, network, filesystem, model provider, or workflow access."
    }
  ],
  "emits": [],
  "consumes": [],
  "permissions": [
    {
      "id": "unknown.organize.execute"
    }
  ],
  "execution": {
    "binary_format": "wasm",
    "entrypoint": {
      "kind": "wasi-command",
      "command": "run"
    },
    "preferred_targets": ["local", "browser", "edge", "device"],
    "constraints": {
      "host_api_access": "none",
      "network_access": "forbidden",
      "filesystem_access": "none"
    }
  },
  "policies": [
    { "id": "deterministic-policy-only" },
    { "id": "clustering-never-implies-identification" }
  ],
  "dependencies": [],
  "provenance": {
    "source": "greenfield",
    "author": "Callweave",
    "created_at": "2026-08-20T00:00:00Z",
    "spec_ref": "100-capability-package-authoring@1.0.0",
    "adr_refs": ["DECISION_RECORD.md"],
    "exception_refs": []
  },
  "evidence": [],
  "state_schema": null,
  "service_type": "stateless",
  "permitted_targets": ["local", "browser", "edge", "device"]
}
