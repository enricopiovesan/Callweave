{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.foundation.evidence.cluster-curate",
  "name": "evidence.cluster-curate",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the standalone evidence.cluster-curate capability as a one-node Traverse workflow.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "cluster",
        "curation_policy"
      ],
      "properties": {
        "cluster": {
          "type": "object",
          "required": [
            "id",
            "member_count",
            "representative_ref"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "member_count": {
              "type": "integer"
            },
            "representative_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "curation_policy": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "cluster_id",
        "member_count",
        "representative_ref",
        "curation_state",
        "policy_version"
      ],
      "properties": {
        "cluster_id": {
          "type": "string"
        },
        "member_count": {
          "type": "integer"
        },
        "representative_ref": {
          "type": "string"
        },
        "curation_state": {
          "type": "string",
          "enum": [
            "retained"
          ]
        },
        "policy_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "nodes": [
    {
      "node_id": "run_capability",
      "capability_id": "evidence.cluster-curate",
      "capability_version": "1.0.0",
      "input": {
        "from_workflow_input": [
          "cluster",
          "curation_policy"
        ]
      },
      "output": {
        "to_workflow_state": [
          "cluster_id",
          "member_count",
          "representative_ref",
          "curation_state",
          "policy_version"
        ]
      }
    }
  ],
  "edges": [],
  "start_node": "run_capability",
  "terminal_nodes": [
    "run_capability"
  ],
  "tags": [
    "callweave",
    "foundation",
    "standalone-capability"
  ],
  "governing_spec": "007-workflow-registry-traversal"
}
