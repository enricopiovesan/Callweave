{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.foundation.artifact.versioned-revision-create",
  "name": "artifact.versioned-revision-create",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the standalone artifact.versioned-revision-create capability as a one-node Traverse workflow.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "artifact",
        "revision_policy"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "id",
            "previous_revision",
            "correction_reason"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "previous_revision": {
              "type": "integer",
              "minimum": 1
            },
            "correction_reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "revision_policy": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "artifact_id",
        "revision_number",
        "supersedes_revision",
        "correction_reason",
        "policy_version"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer"
        },
        "supersedes_revision": {
          "type": "integer"
        },
        "correction_reason": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "nodes": [
    {
      "node_id": "run_capability",
      "capability_id": "artifact.versioned-revision-create",
      "capability_version": "1.0.0",
      "input": {
        "from_workflow_input": [
          "artifact",
          "revision_policy"
        ]
      },
      "output": {
        "to_workflow_state": [
          "artifact_id",
          "revision_number",
          "supersedes_revision",
          "correction_reason",
          "policy_version"
        ]
      }
    }
  ],
  "edges": [],
  "start_node": "run_capability",
  "terminal_nodes": [
    "run_capability"
  ],
  "tags": [
    "callweave",
    "foundation",
    "standalone-capability"
  ],
  "governing_spec": "007-workflow-registry-traversal"
}
