{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.foundation.privacy.gate-evaluate",
  "name": "privacy.gate-evaluate",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the standalone privacy.gate-evaluate capability as a one-node Traverse workflow.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "cases",
        "policy"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "contains_speech",
              "risk_detected"
            ],
            "properties": {
              "contains_speech": {
                "type": "boolean"
              },
              "risk_detected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "version",
            "minimum_speech_cases",
            "maximum_false_negative_millis"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "minimum_speech_cases": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_false_negative_millis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "policy_version",
        "total_cases",
        "speech_cases",
        "false_negatives",
        "false_negative_millis",
        "decision",
        "reason"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "total_cases": {
          "type": "integer",
          "minimum": 1
        },
        "speech_cases": {
          "type": "integer",
          "minimum": 0
        },
        "false_negatives": {
          "type": "integer",
          "minimum": 0
        },
        "false_negative_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve_for_policy",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "privacy_gate_passed",
            "insufficient_speech_cases",
            "false_negative_limit_exceeded"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "nodes": [
    {
      "node_id": "run_capability",
      "capability_id": "privacy.gate-evaluate",
      "capability_version": "1.0.0",
      "input": {
        "from_workflow_input": [
          "cases",
          "policy"
        ]
      },
      "output": {
        "to_workflow_state": [
          "policy_version",
          "total_cases",
          "speech_cases",
          "false_negatives",
          "false_negative_millis",
          "decision",
          "reason"
        ]
      }
    }
  ],
  "edges": [],
  "start_node": "run_capability",
  "terminal_nodes": [
    "run_capability"
  ],
  "tags": [
    "callweave",
    "foundation",
    "standalone-capability"
  ],
  "governing_spec": "007-workflow-registry-traversal"
}
