{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.foundation.evidence.retention-classify",
  "name": "evidence.retention-classify",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the standalone evidence.retention-classify capability as a one-node Traverse workflow.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "asset",
        "retention_policy"
      ],
      "properties": {
        "asset": {
          "type": "object",
          "required": [
            "id",
            "reference_count",
            "legal_hold",
            "review_hold"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "reference_count": {
              "type": "integer"
            },
            "legal_hold": {
              "type": "boolean"
            },
            "review_hold": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "retention_policy": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "asset_id",
        "retention_state",
        "reason_code",
        "policy_version"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "retention_state": {
          "type": "string",
          "enum": [
            "held",
            "retained",
            "eligible"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "legal_hold",
            "review_hold",
            "active_reference",
            "no_active_dependency"
          ]
        },
        "policy_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "nodes": [
    {
      "node_id": "run_capability",
      "capability_id": "evidence.retention-classify",
      "capability_version": "1.0.0",
      "input": {
        "from_workflow_input": [
          "asset",
          "retention_policy"
        ]
      },
      "output": {
        "to_workflow_state": [
          "asset_id",
          "retention_state",
          "reason_code",
          "policy_version"
        ]
      }
    }
  ],
  "edges": [],
  "start_node": "run_capability",
  "terminal_nodes": [
    "run_capability"
  ],
  "tags": [
    "callweave",
    "foundation",
    "standalone-capability"
  ],
  "governing_spec": "007-workflow-registry-traversal"
}
