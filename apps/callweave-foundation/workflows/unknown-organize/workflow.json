{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.foundation.unknown.organize",
  "name": "unknown.organize",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the standalone unknown.organize capability as a one-node Traverse workflow.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "items",
        "policy"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "embedding"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "embedding": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1
              }
            },
            "additionalProperties": true
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "version",
            "minimum_cosine"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "minimum_cosine": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "member_ids",
          "representative_id",
          "policy_version"
        ],
        "properties": {
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "representative_id": {
            "type": "string"
          },
          "policy_version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "nodes": [
    {
      "node_id": "run_capability",
      "capability_id": "unknown.organize",
      "capability_version": "1.0.0",
      "input": {
        "from_workflow_input": [
          "items",
          "policy"
        ]
      },
      "output": {
        "to_workflow_state": []
      }
    }
  ],
  "edges": [],
  "start_node": "run_capability",
  "terminal_nodes": [
    "run_capability"
  ],
  "tags": [
    "callweave",
    "foundation",
    "standalone-capability"
  ],
  "governing_spec": "007-workflow-registry-traversal"
