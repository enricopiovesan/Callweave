{
  "app_id": "callweave.pwa",
  "app_version": "0.1.3",
  "initial_state": "idle",
  "states": [
    {
      "id": "idle",
      "invoke": null,
      "transitions": [
        {
          "on": "request_capture",
          "to": "planning"
        }
      ]
    },
    {
      "id": "planning",
      "invoke": {
        "capability_id": "core.create-audio-capture-request-plan",
        "input_from": "command.payload"
      },
      "transitions": [
        {
          "on": "capability_succeeded",
          "condition": {
            "field": "output.result_class",
            "op": "eq",
            "value": "planned"
          },
          "to": "capture_planned"
        },
        {
          "on": "capability_succeeded",
          "to": "request_rejected"
        },
        {
          "on": "capability_failed",
          "to": "request_rejected"
        }
      ]
    },
    {
      "id": "capture_planned",
      "invoke": null,
      "transitions": [
        {
          "on": "reset",
          "to": "idle"
        }
      ]
    },
    {
      "id": "request_rejected",
      "invoke": null,
      "transitions": [
        {
          "on": "retry",
          "to": "planning",
          "with_last_payload": true
        },
        {
          "on": "reset",
          "to": "idle"
        }
      ]
    }
  ]
}
