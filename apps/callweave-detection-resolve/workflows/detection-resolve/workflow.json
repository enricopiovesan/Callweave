{
  "kind": "workflow_definition",
  "schema_version": "1.0.0",
  "id": "callweave.detection-resolve-test.workflow",
  "name": "detection-resolve-test",
  "version": "0.1.0",
  "lifecycle": "active",
  "owner": {
    "team": "callweave",
    "contact": "maintainers@callweave.local"
  },
  "summary": "Exercise the compatible detection-resolve component through the app registration path.",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "request_id",
        "workspace_id",
        "location_id",
        "idempotency_key",
        "acoustic_evidence_ref",
        "resolution_context"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "location_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "runtime_context": {
          "type": "object",
          "required": [
            "input_reference_state",
            "dependency_state",
            "policy_state"
          ],
          "properties": {
            "input_reference_state": {
              "type": "string",
              "enum": [
                "resolvable",
                "unresolvable"
              ]
            },
            "dependency_state": {
              "type": "string",
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "policy_state": {
              "type": "string",
              "enum": [
                "allowed",
                "denied"
              ]
            }
          },
          "additionalProperties": false
        },
        "acoustic_evidence_ref": {
          "type": "object",
          "required": [
            "id",
            "record_type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "record_type": {
              "type": "string",
              "const": "AcousticEvidence"
            }
          },
          "additionalProperties": false
        },
        "resolution_context": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "status",
        "reason_code",
        "resolution_ref",
        "trace_ref",
        "warnings",
        "resolution_state",
        "emitted_event_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "rejected",
            "deferred"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ok",
            "invalid_input",
            "dependency_unavailable",
            "policy_denied"
          ]
        },
        "resolution_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_ref": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "provisional",
            "unknown",
            "surprising",
            "rejected",
            null
          ]
        },
        "emitted_event_id": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "callweave.detection.provisional-created",
            "callweave.detection.unknown-identified",
            "callweave.detection.surprising-quarantined",
            "callweave.detection.rejected",
            null
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "nodes": [
    {
      "node_id": "resolve_detection",
      "capability_id": "callweave.detection-resolve",
      "capability_version": "0.1.0",
      "input": {
        "from_workflow_input": [
          "request_id",
          "workspace_id",
          "location_id",
          "idempotency_key",
          "runtime_context",
          "acoustic_evidence_ref",
          "resolution_context"
        ]
      },
      "output": {
        "to_workflow_state": [
          "status",
          "reason_code",
          "resolution_ref",
          "trace_ref",
          "warnings",
          "resolution_state",
          "emitted_event_id"
        ]
      }
    }
  ],
  "edges": [],
  "start_node": "resolve_detection",
  "terminal_nodes": [
    "resolve_detection"
  ],
  "tags": [
    "callweave",
    "compatible",
    "host-adapter",
    "detection-resolve"
  ],
  "governing_spec": "007-workflow-registry-traversal"
}
